# ==========================================
# Coder Agent Configuration
# ==========================================

# Active provider: anthropic | bedrock | azure | ollama
CODER_AGENT_PROVIDER=anthropic

# Approval mode: always | destructive | never (default: destructive)
CODER_AGENT_APPROVAL=destructive

# Log level: debug | info | warn | error
CODER_AGENT_LOG_LEVEL=info

# ------------------------------------------
# Provider: Anthropic (Direct API)
# ------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Model default: claude-sonnet-4-20250514 (or claude-3-5-sonnet-latest, claude-opus-4-20250514)
CODER_AGENT_MODEL=claude-sonnet-4-20250514

# ------------------------------------------
# Provider: AWS Bedrock
# ------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SESSION_TOKEN=optional-session-token
# Model example: anthropic.claude-sonnet-4-20250514-v1:0 or anthropic.claude-3-5-sonnet-20241022-v2:0

# ------------------------------------------
# Provider: Azure OpenAI
# ------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_API_VERSION=2024-10-01-preview
# Model / Deployment name: gpt-4o

# ------------------------------------------
# Provider: Ollama / Local OpenAI-Compatible LLM
# ------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Model: qwen3, llama3.3, mistral-small
